%labshare ALL=(ALL) NOPASSWD: /usr/sbin/groupadd proj_*
%labshare ALL=(ALL) NOPASSWD: /usr/sbin/groupdel proj_*
%labshare ALL=(ALL) NOPASSWD: /usr/sbin/usermod -aG proj_* *
%labshare ALL=(ALL) NOPASSWD: /usr/bin/gpasswd -d * proj_*
